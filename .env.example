# Docker Compose development environment. Copy to .env and replace secrets as needed.
POSTGRES_DB=frota_rural
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_DEBUG=true
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/

# Optional integrations
RESEND_API_KEY=
RESEND_SUPPORT_EMAIL=onboarding@resend.dev
FIREBASE_STORAGE_BUCKET=
# This path is inside the backend container. Mount a local credentials file separately if needed.
FIREBASE_CREDENTIALS_FILE=firebase-service-account.json
CONTRACT_SIGNATURE_REQUIRE_OTP=false
