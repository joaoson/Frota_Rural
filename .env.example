# Docker Compose development environment. Copy to .env and replace secrets as needed.
POSTGRES_DB=frota_rural
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_DEBUG=true
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/

# Optional integrations
RESEND_API_KEY=
RESEND_SUPPORT_EMAIL=onboarding@resend.dev
FIREBASE_STORAGE_BUCKET=
# This path is inside the backend container. Mount a local credentials file separately if needed.
FIREBASE_CREDENTIALS_FILE=firebase-service-account.json
CONTRACT_SIGNATURE_REQUIRE_OTP=false

# Chat em tempo real (Django Channels)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# redis | memory. "memory" so vale com DJANGO_DEBUG=true e um unico processo:
# o fan-out entre workers nao acontece, por isso settings.py recusa fora do DEBUG.
CHANNEL_LAYER_BACKEND=redis
VITE_WS_BASE_URL=ws://localhost:8000
# Palavras bloqueadas na moderacao do chat, separadas por virgula.
CHAT_BANNED_WORDS=

# Sugestao de valor/hora por IA (opcional).
# Crie uma chave no plano Free em https://console.groq.com/keys
# Sem chave/cota/dados confiaveis, o anuncio continua com preco manual (422).
PRICING_AI_PROVIDER=groq
GROQ_API_KEY=
# Alternativas explicitas; nunca ha fallback automatico entre provedores.
# Gemini 2.5 Flash pode estar indisponivel para contas novas. Modelos mais
# recentes podem cobrar pela busca: confira os precos antes de trocar.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
