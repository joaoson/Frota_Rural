# Optional: copy to .env.local to customize the isolated LOCAL environment.
# develop, acceptance and feature branches use local PostgreSQL automatically.
# Devops/dev.py uses this example directly when .env.local does not exist.
POSTGRES_DB=frota_rural
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DJANGO_SECRET_KEY=django-insecure-isolated-local-development-only

# Local migrations are automatic. Supabase migrations always remain manual.
RUN_MIGRATIONS=auto

# Integrations are disabled unless explicitly configured in this selected file.
# Use Stripe TEST keys and dedicated development accounts/buckets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_SUPPORT_EMAIL=onboarding@resend.dev
FIREBASE_STORAGE_BUCKET=
FIREBASE_CREDENTIALS_FILE=
PRICING_AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CONTRACT_SIGNATURE_REQUIRE_OTP=false
# Reverse proxies trusted for X-Forwarded-For in signature evidence (IPs/CIDRs, comma-separated).
CONTRACT_TRUSTED_PROXIES=
