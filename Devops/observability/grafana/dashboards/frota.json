{
  "uid": "frota-rural",
  "title": "Frota Rural \u2014 Opera\u00e7\u00e3o",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API dispon\u00edvel",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "frota-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"frota-backend\"}",
          "legendFormat": "{{route}}{{dependency}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Depend\u00eancias",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "frota-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "frota_dependency_up",
          "legendFormat": "{{route}}{{dependency}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Requisi\u00e7\u00f5es por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "frota-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(frota_http_requests_total[5m]))",
          "legendFormat": "{{route}}{{dependency}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Erros 5xx por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "frota-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(frota_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{route}}{{dependency}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Lat\u00eancia p95 por rota",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "frota-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(frota_http_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}{{dependency}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Mem\u00f3ria do processo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "frota-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{route}}{{dependency}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Alertas ativos",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "frota-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{route}}{{dependency}}{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
