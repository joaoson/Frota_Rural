# Copy to .env.supabase (ignored by Git). Keep passwords out of chat and screenshots.
# Dashboard > Connect > Session pooler (port 5432). Copy the exact host and username.
# Replace the password locally and percent-encode reserved characters.
# Single quotes prevent Docker Compose from expanding a $ in the value.
DATABASE_URL='postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require'
DB_SCHEMA=frota_rural
DB_SSLMODE=require
# For certificate verification: use sslmode=verify-full in DATABASE_URL and
# DB_SSLROOTCERT=/app/certs/prod-ca-2021.crt (place the downloaded certificate in BackEnd/certs/).

# Start only after following Devops/SUPABASE.md.
# On main, Devops/dev.py automatically uses ONLY this file, not root/BackEnd .env.
# develop, acceptance and feature branches default to local PostgreSQL.
# Add desired integration settings here (Groq, Stripe TEST keys, Resend, Firebase).
# See .env.local.example for available integration fields. Do not commit real keys.
